// Rogue Galaxy -- SCUS_974.90, the main executable.
//
// PHASE 1 LINK TARGET: reproduce the shipped ELF byte for byte from reference
// assembly, with ZERO functions in C. Written 2026-08-22.
//
// The two objects are GNU-as output, assembled straight from splat's
// disassembly. mwldps2 accepts them provided the ZERO-SIZE .data/.bss that
// GNU as emits are stripped first -- that removal is necessary and sufficient;
// .MIPS.abiflags and .gnu.attributes are tolerated.
//
// The absolute assignments at the bottom are every symbol left unresolved
// after both objects are linked together -- bss and overlay-space addresses
// that no subsegment defines. Their names encode their own addresses, which is
// the only reason this is mechanical.
//
// NOTE: mwld's lcf parser rejects /* */ comments -- use // or #.
MEMORY
{
    main (RWX) : ORIGIN = 0x00100000, LENGTH = 0

    // The seven overlay reservations, all at the same address -- they are
    // alternatives, only one is resident at a time. Order here is the overlay
    // ID order, which is the order retail's program headers are in.
    ov1 (RWX) : ORIGIN = 0x004E9E80, LENGTH = 0
    ov2 (RWX) : ORIGIN = 0x004E9E80, LENGTH = 0
    ov3 (RWX) : ORIGIN = 0x004E9E80, LENGTH = 0
    ov4 (RWX) : ORIGIN = 0x004E9E80, LENGTH = 0
    ov5 (RWX) : ORIGIN = 0x004E9E80, LENGTH = 0
    ov6 (RWX) : ORIGIN = 0x004E9E80, LENGTH = 0
    ov7 (RWX) : ORIGIN = 0x004E9E80, LENGTH = 0

    // Retail's ninth segment: RW (flg 0x6), memsz 0. 0x4E9E80 + the LARGEST
    // reservation (0x3E380, normal.bin) is exactly 0x528200.
    heap (RW) : ORIGIN = 0x00528200, LENGTH = 0
}

SECTIONS
{
    .main :
    {
        // ALIGN(128) is what sets the SEGMENT's p_align to 0x80. `_align_segment`
        // in the body is inert -- it is defined here because retail defines it,
        // but it does not drive the header.
        . = ALIGN(128);
        ALIGNALL(1);
        main_text.o (.text)
        *(.text)
        data2c_0046F9C0.o (.data)
