# Game code (game/, generated by tools/ingest.py) as OBJECT libraries, one per
# image: rg_game_main, rg_game_title, ... and the umbrella target
# rg_game_objs (EXCLUDE_FROM_ALL; linked into rg-game by cmake/game_link.cmake,
# docs/LINK.md):
#   cmake --build build\i686-windows --target rg_game_objs -- -k 0
#
# The source list is generated from game/MANIFEST.tsv by tools/gamesrcs.py
# (configure never globs game/).  Re-configure after a re-ingest (MANIFEST.tsv
# is a configure dependency) or after adding a file under overrides/.
#
# Flags: PLAN D2 (rg_flags), then the port include order (docs/PORT-HEADERS.md:
# -include port/prelude.h, include/ AHEAD of game/include) via
# rg_game_headers, then the C-only conversions docs/PROTOS.md leaves to the
# compiler.  -fgnu89-inline: a handful of units define a plain `inline`
# function (mwcc emitted it out of line); C99 semantics would leave an
# undefined reference.  -Wno-return-mismatch: 31 functions `return;` from a
# non-void function (retail returned whatever $v0 held; listed in
# game_compile_errors.tsv as review items).  -Wno-implicit-function-declaration:
# 8 calls with no declaration in the decomp (strcpy/strcat/strcmp get their
# builtin types; the 2 game callees are link-time items).  Warnings are off
# (-w): this is decompiled code.  Keep tools/syntaxcheck.py C_FLAGS in sync.

set(RG_GAME_MANIFEST ${RG_GAME_TREE}/MANIFEST.tsv)
if(NOT EXISTS ${RG_GAME_MANIFEST})
  message(STATUS "game/: no MANIFEST.tsv (run tools/ingest.py); rg_game_objs not defined")
  return()
endif()
if(NOT RG_PYTHON)
  message(STATUS "game/: no python; rg_game_objs not defined")
  return()
endif()

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  ${RG_GAME_MANIFEST} ${CMAKE_SOURCE_DIR}/tools/gamesrcs.py
  ${CMAKE_SOURCE_DIR}/overrides/PORT_PROVIDED.tsv)
set(RG_GAME_LIST ${CMAKE_BINARY_DIR}/game_sources.cmake)
set(_rg_gamesrcs_args --game ${RG_GAME_TREE})
if(RG_ARCH STREQUAL "x64")
  # the derived tree's overrides/ and missing/ (tools/x64/derive.py, cmake/x64.cmake)
  list(APPEND _rg_gamesrcs_args --overrides ${RG_X64_SRC}/overrides --missing ${RG_X64_SRC}/missing)
endif()
execute_process(
  COMMAND ${RG_PYTHON} ${CMAKE_SOURCE_DIR}/tools/gamesrcs.py ${RG_GAME_LIST} ${_rg_gamesrcs_args}
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "tools/gamesrcs.py failed: ${_out}")
endif()
message(STATUS "${_out}")
include(${RG_GAME_LIST})

add_library(rg_game_flags INTERFACE)
target_link_libraries(rg_game_flags INTERFACE rg_flags rg_game_headers)
set(RG_GAME_C_FLAGS
  -Wno-int-conversion -Wno-incompatible-pointer-types
  -Wno-incompatible-function-pointer-types -fgnu89-inline
  -Wno-implicit-function-declaration)
# C++: -Wno-c++11-narrowing -- a brace initializer of a u64 bitfield struct
# from an s32 call (FontDrawText_26cdc0 `RGBAQ e = {.., f(self), 0}`, d784320c)
# is a narrowing ERROR in C++11; mwcc's C++ (pre-11) took the conversion.
# C++: -fno-strict-return -- a value function that can flow off its end
# (EvRemoveChrMonographs_2e9060: m2c dropped the $v0 the EE leaves there) is
# `unreachable` under C++ rules, and the MSVC target traps it (int3); mwcc
# just returned whatever $v0 held.  C already behaves that way.
# -ftrivial-auto-var-init=zero -- the decomp reads uninitialised locals on
# purpose (mwcc register-allocation steering: VecWrapAngle_1cbe90's
# `f32 *c; if (c) { .. }` before c is set; m2c placeholders).  A branch on an
# uninitialised value is UB that clang turns into `unreachable` = int3 on the
# MSVC target (golden run, field ~11,500, BRINGUP.md checkpoint).  Zeroing
# makes every such read defined; mwcc's register held an arbitrary value too.
# UB audit (docs/UB-AUDIT.md), defined behaviour where the decomp relies on the
# EE's and clang would otherwise be free to differ between builds:
# -fno-strict-float-cast-overflow -- float->int of NaN / +-inf / out of range
#   saturates (llvm.fptosi.sat) instead of being poison: TexAnime scroll steps
#   (x/0) and AudioDecSetInputVolume_1d2b90 (4.29e9 -> s32) gave build-dependent
#   values (O1 vs UBSan vs local-VU0 builds rendered/sounded differently from field
#   12,1xx); the EE's cvt.w.s saturates too.
# -fwrapv-pointer -- pointer arithmetic wraps like MIPS addu (-fwrapv alone still
#   folds `p + i < p` to `i < 0`; VectorU32InsertN_1a4e80 computes such a pointer).
# -fno-finite-loops -- no C++ forward-progress assumption (mwcc made none; game
#   busy-waits on memory other code changes).
target_compile_options(rg_game_flags INTERFACE
  -w -ferror-limit=0 -Wno-return-mismatch -ftrivial-auto-var-init=zero
  -fno-strict-float-cast-overflow -fwrapv-pointer -fno-finite-loops
  "$<$<COMPILE_LANGUAGE:C>:${RG_GAME_C_FLAGS}>"
  "$<$<COMPILE_LANGUAGE:CXX>:-Wno-c++11-narrowing;-fno-strict-return>")

# RG_GAME_OPT: the optimisation level of the game objects (game/, overrides/,
# missing/: the rg_game_<image> sources).  docs/UB-AUDIT.md.  CMake keeps only
# the first of duplicate options and a target's interface options come before
# rg_flags', so a level other than -O1 is ALSO set as a source property
# (source options come last on the command line and win; loop below).
# Default -O2 since the UB audit (2026-10-18): the route runs field-for-field
# identically to -O1 (run hash + frames at every fixture milestone) and the EE
# step is a few % faster.  An existing build dir keeps its cached value.
set(RG_GAME_OPT "-O2" CACHE STRING "optimisation level of the game sources (docs/UB-AUDIT.md)")
target_compile_options(rg_game_flags INTERFACE ${RG_GAME_OPT})

# RG_VU0_NO_FRAMES=ON: A/B verification of the vu0frame stage only (port/vu0.h):
# the function-local VU0 register files are turned off, every game function runs
# on the file-scope one (the pre-stage behaviour).  docs/UB-AUDIT.md "vu0frame".
option(RG_VU0_NO_FRAMES "vu0frame A/B check: VU0 frames off (docs/UB-AUDIT.md)" OFF)
if(RG_VU0_NO_FRAMES)
  target_compile_definitions(rg_game_flags INTERFACE RG_VU0_NO_FRAMES=1)
endif()

# RG_UBSAN=ON: UB census build (docs/UB-AUDIT.md).  The game objects are
# compiled with -fsanitize=undefined (recoverable) and the handlers come from
# src/game/ubsan_census.c, a logging runtime (LLVM ships no i386 ubsan
# runtime for Windows): every check site that fires is appended once to
# $RG_UBSAN_LOG (default ubsan_census.tsv) and counted.  Never a shipping build.
option(RG_UBSAN "UB census build of the game sources (docs/UB-AUDIT.md)" OFF)
set(RG_UBSAN_CHECKS "undefined" CACHE STRING "-fsanitize= list for RG_UBSAN")
if(RG_UBSAN)
  add_library(rg_ubsan_census STATIC ${CMAKE_SOURCE_DIR}/src/game/ubsan_census.c)
  target_link_libraries(rg_ubsan_census PRIVATE rg_flags)
  # the objects ask for clang's runtime by /DEFAULTLIB; there is none for i386
  if(WIN32)
    target_link_options(rg_ubsan_census INTERFACE
      "LINKER:/NODEFAULTLIB:clang_rt.ubsan_standalone.lib"
      "LINKER:/NODEFAULTLIB:clang_rt.ubsan_standalone_cxx.lib")
  endif()
  target_compile_options(rg_game_flags INTERFACE
    -fsanitize=${RG_UBSAN_CHECKS} -fno-sanitize=vptr,function -fsanitize-recover=all)
  target_link_libraries(rg_game_flags INTERFACE rg_ubsan_census)
endif()

# RG_SBGUARD=ON: stack-guard census build (docs/PROTOS.md "Stack-block census").
# Only meaningful with RG_GAME_TREE pointing at a tree ingested with
# RG_PROTOS_SB_GUARD=1 (every address-escaping local inside a canary-guarded
# byte array); src/game/sbguard_census.c checks the canaries and logs overruns
# to $RG_SBGUARD_LOG.  Never a shipping build.
option(RG_SBGUARD "stack-guard census runtime (docs/PROTOS.md)" OFF)
if(RG_SBGUARD)
  add_library(rg_sbguard_census STATIC ${CMAKE_SOURCE_DIR}/src/game/sbguard_census.c)
  target_link_libraries(rg_sbguard_census PRIVATE rg_flags)
  target_link_libraries(rg_game_flags INTERFACE rg_sbguard_census)
endif()

# What the game executable must link besides the rg_game_<image> objects
# (rg-game: cmake/game_link.cmake).  Stage-introduced runtime dependencies go here:
#   hwaccess (docs/HWBUS.md): HW_R*/HW_W*/PS2_SPR/RG_OVL_DATA -> rg_ps2_hwbus
# (port/hwaccess.h and port/vcall.h are force-included through port/prelude.h)
add_library(rg_game_link_deps INTERFACE)
if(TARGET rg_ps2_hwbus)
  target_link_libraries(rg_game_link_deps INTERFACE rg_ps2_hwbus)
endif()

add_custom_target(rg_game_objs)
foreach(img ${RG_GAME_IMAGES})
  add_library(rg_game_${img} OBJECT EXCLUDE_FROM_ALL ${RG_GAME_SRCS_${img}})
  if(NOT RG_GAME_OPT STREQUAL "-O1")
    set_property(SOURCE ${RG_GAME_SRCS_${img}} APPEND PROPERTY COMPILE_OPTIONS ${RG_GAME_OPT})
  endif()
  target_link_libraries(rg_game_${img} PRIVATE rg_game_flags)
  add_dependencies(rg_game_objs rg_game_${img})
endforeach()
